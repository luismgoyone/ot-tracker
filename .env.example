# Backend (copy to backend/.env for local development)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ot_tracker
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_SSL=false
# Required. Use a long random value in production, e.g. `openssl rand -base64 48`.
JWT_SECRET=your-very-secure-jwt-secret-key-here-change-this-in-production
NODE_ENV=development
# Timezone that decides what "today" and "this month" mean in reports.
APP_TIMEZONE=Asia/Manila
# Optional: extra origins allowed to call the API directly (comma-separated).
# CORS_ORIGINS=http://localhost:3000
# Optional: number of reverse proxies in front of the API (2 in production: Netlify + Render).
# TRUST_PROXY_HOPS=1

# The frontend needs no environment variables: it calls /api, which Vite (dev),
# nginx (Docker) and Netlify (production) proxy to the backend.
